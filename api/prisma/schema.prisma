generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               String   @default("USER")
  hashedRefreshToken String?
  playerId           String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  player             Player?  @relation(fields: [playerId], references: [id])
}

model Player {
  id               String    @id @default(uuid())
  name             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  playerType       String    @default("FIXED")
  mvpAwards        Match[]   @relation("MatchMVP")
  mvpVotesReceived MvpVote[] @relation("CandidateRelation")
  mvpVotesCast     MvpVote[] @relation("VoterRelation")
  payments         Payment[]
  rsvps            Rsvp[]
  championshipsWon Season[]  @relation("SeasonChampion")
  user             User?
  teamAMatches     Match[]   @relation("TeamAMatches")
  teamBMatches     Match[]   @relation("TeamBMatches")
  awards           Award[]
}

model Season {
  id         String   @id @default(uuid())
  year       Int
  seasonType String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  championId String?
  matches    Match[]
  champion   Player?  @relation("SeasonChampion", fields: [championId], references: [id])
  awards     Award[]
}

model Match {
  id           String    @id @default(uuid())
  seasonId     String
  playedAt     DateTime  @default(now())
  status       String    @default("SCHEDULED")
  isLegacy     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  mvpId        String?
  teamAScore   Int?
  teamBScore   Int?
  updatedAt    DateTime  @updatedAt
  rsvpDeadline DateTime?
  mvp          Player?   @relation("MatchMVP", fields: [mvpId], references: [id])
  season       Season    @relation(fields: [seasonId], references: [id])
  mvpVotes     MvpVote[]
  rsvps        Rsvp[]
  teamAPlayers Player[]  @relation("TeamAMatches")
  teamBPlayers Player[]  @relation("TeamBMatches")
}

model Payment {
  id        String    @id @default(uuid())
  playerId  String
  amount    Decimal   @db.Decimal(10, 2)
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  player    Player    @relation(fields: [playerId], references: [id])
}

model MvpVote {
  id          String   @id @default(uuid())
  matchId     String
  voterId     String
  candidateId String
  createdAt   DateTime @default(now())
  candidate   Player   @relation("CandidateRelation", fields: [candidateId], references: [id], onDelete: Cascade)
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voter       Player   @relation("VoterRelation", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([matchId, voterId])
}

model Rsvp {
  id        String   @id @default(uuid())
  matchId   String
  playerId  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

// WHY: Stores honors (champions, top scorer, etc.) as first-class records so that historical
// achievements predating the app can live in the Hall of Fame without a full Season behind them.
model Award {
  id        String   @id @default(uuid())
  type      String   @default("CHAMPION") // 'CHAMPION', 'TOP_SCORER', 'MVP_OF_SEASON'
  title     String? // Optional display label, e.g. "Champion 2024 Winter"
  year      Int // Self-contained year so legacy awards stand alone without a Season row.
  playerId  String
  seasonId  String? // Null for pre-app legacy honors with no Season record.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id])
  season    Season?  @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId, type]) // Prevent duplicate season-backed honors per player.
}
