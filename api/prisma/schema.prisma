// WHY: We use Prisma as our ORM to guarantee type safety and prevent SQL injections.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String  @id @default(uuid())
  email              String  @unique
  passwordHash       String
  role               String  @default("USER") // e.g., 'ADMIN', 'TREASURER', 'USER'
  hashedRefreshToken String?

  // WHY: Optional 1-to-1 relation. A user might be a player, or just a system admin/treasurer.
  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id         String   @id @default(uuid())
  name       String
  playerType String   @default("FIXED") // 'FIXED', 'GUEST'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  // Disambiguated implicit Many-to-Many relations for Team A and Team B
  teamAMatches Match[] @relation("TeamAMatches")
  teamBMatches Match[] @relation("TeamBMatches")

  // One-to-Many: A player can be MVP in multiple matches
  mvpAwards Match[] @relation("MatchMVP")

  // One-to-Many: Financial contributions
  payments Payment[]

  // One-to-One: A player can have a user account
  user User?

  // Relations to MVP Votes
  mvpVotesCast     MvpVote[] @relation("VoterRelation")
  mvpVotesReceived MvpVote[] @relation("CandidateRelation")

  // Relations to RSVPs (Convocatórias)
  rsvps Rsvp[]

  // Relations to championships won
  championshipsWon Season[] @relation("SeasonChampion")
}

model Season {
  id         String   @id @default(uuid())
  year       Int
  seasonType String // e.g., 'WINTER', 'SUMMER'
  status     String // e.g., 'ACTIVE', 'FINISHED'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  matches Match[]

  // Relations for Season Champion
  championId String?
  champion   Player? @relation("SeasonChampion", fields: [championId], references: [id])
}

model Match {
  id       String   @id @default(uuid())
  seasonId String
  season   Season   @relation(fields: [seasonId], references: [id])
  playedAt DateTime @default(now())
  status   String   @default("SCHEDULED") // e.g., 'SCHEDULED', 'COMPLETED'

  // Match result (null until Admin inputs the score)
  teamAScore Int?
  teamBScore Int?

  // Explicit assignment to Team A and Team B via implicit M2M tables
  teamAPlayers Player[] @relation("TeamAMatches")
  teamBPlayers Player[] @relation("TeamBMatches")

  // MVP is awarded after the match concludes
  mvpId String?
  mvp   Player? @relation("MatchMVP", fields: [mvpId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to MVP Votes
  mvpVotes MvpVote[]

  rsvpDeadline DateTime?
  rsvps        Rsvp[]
}

model Payment {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  amount Decimal @db.Decimal(10, 2)
  status String  @default("PENDING") // e.g., 'PENDING', 'PAID', 'CANCELLED'

  // Audit trail requirements
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // WHY: Soft delete to preserve financial history and guarantee append-only ledger
}

model MvpVote {
  id          String   @id @default(uuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voterId     String   // Player ID of the voter
  voter       Player   @relation("VoterRelation", fields: [voterId], references: [id], onDelete: Cascade)
  candidateId String   // Player ID of the candidate voted for
  candidate   Player   @relation("CandidateRelation", fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([matchId, voterId]) // WHY: Ensure a participant can cast exactly one vote per match.
}

model Rsvp {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // 'PENDING', 'CONFIRMED', 'DECLINED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId]) // WHY: Ensure exactly one RSVP record per player per match.
}
